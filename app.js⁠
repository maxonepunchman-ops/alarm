// State
let currentWater = 0;
let dailyGoal = 2000;
let streak = 0;
let completedDays = [];
let historyStack = [];
let confettiActive = false;
let detectedWaterAmount = 0;
let tfModel = null;

// UI Elements
const waterAmountEl = document.getElementById('waterAmount');
const percentAmountEl = document.getElementById('percentAmount');
const headerGoalEl = document.getElementById('headerGoal');
const streakCountEl = document.getElementById('streakCount');
