    document.getElementById('scannedImg').src = '';
    document.getElementById('scannerPlaceholder').style.display = 'block';
    document.getElementById('aiResultCard').style.display = 'none';
    clearPhotoBtn.style.display = 'none';
}

clearPhotoBtn.addEventListener('click', resetAiScanner);

async function processAiImage(event) {
    const file = event.target.files[0];
    if (!file) return;

    const scannedImg = document.getElementById('scannedImg');
    const placeholder = document.getElementById('scannerPlaceholder');
    const scanLine = document.getElementById('scanLine');
    const loadingText = document.getElementById('aiLoadingText');
    const resultCard = document.getElementById('aiResultCard');

    const reader = new FileReader();
    reader.onload = async function(e) {
        scannedImg.src = e.target.result;
        scannedImg.style.display = 'block';
        placeholder.style.display = 'none';
        scanLine.style.display = 'block';
        clearPhotoBtn.style.display = 'block';
        loadingText.innerText = "COCO-SSD ищет объекты...";
        loadingText.style.display = 'block';
        resultCard.style.display = 'none';

        scannedImg.onload = async () => {
            try {
                if (!tfModel) {
                    tfModel = await cocoSsd.load(); // Умная модель Object Detection
                }
                
                const predictions = await tfModel.detect(scannedImg);
                scanLine.style.display = 'none';
                loadingText.style.display = 'none';

                console.log("Found Objects:", predictions);

                let estVolume = 0;
                let detectedName = "Неизвестно";

                // Ищем подходящие объекты среди найденных
                const validObject = predictions.find(p => 
                    ['bottle', 'cup', 'wine glass', 'bowl'].includes(p.class)
                );

                if (validObject) {
                    detectedName = validObject.class;
                    if (detectedName === 'bottle') estVolume = 500;
                    if (detectedName === 'cup') estVolume = 250;
                    if (detectedName === 'wine glass') estVolume = 200;
                    if (detectedName === 'bowl') estVolume = 400;

                    detectedWaterAmount = estVolume;
                    document.getElementById('aiClassLabel').innerText = `Найдено: ${detectedName}`;
                    document.getElementById('aiResultVal').innerText = `~${detectedWaterAmount} мл`;
                    document.getElementById('aiConfirmBtn').style.display = 'block';
                } else {
                    detectedWaterAmount = 0;
                    document.getElementById('aiClassLabel').innerText = `Посуда не найдена`;
                    document.getElementById('aiResultVal').innerText = `0 мл`;
                    document.getElementById('aiConfirmBtn').style.display = 'none';
                }
                resultCard.style.display = 'block';
                
            } catch (err) {
                console.error(err);
                scanLine.style.display = 'none';
                loadingText.innerText = "Ошибка нейросети";
            }
        };
    };
    reader.readAsDataURL(file);
}

function confirmAiWater() {
    if (detectedWaterAmount > 0) {
        addWater(detectedWaterAmount);
        aiOverlay.classList.remove('active');
        resetAiScanner();
    }
}

