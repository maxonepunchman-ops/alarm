function getTodayStr() {
    const d = new Date();
    return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
}

function loadState() {
    const todayStr = getTodayStr();
    const savedDate = localStorage.getItem('h2o_date');
    
    dailyGoal = parseInt(localStorage.getItem('h2o_goal')) || 2000;
    streak = parseInt(localStorage.getItem('h2o_streak')) || 0;
    
    try {
        completedDays = JSON.parse(localStorage.getItem('h2o_completed_days')) || [];
    } catch(e) { completedDays = []; }

    if (savedDate !== todayStr) {
        localStorage.setItem('h2o_date', todayStr);
        currentWater = 0;
        historyStack = [];
        localStorage.setItem('h2o_current', '0');
        localStorage.setItem('h2o_history', '[]');
    } else {
        currentWater = parseInt(localStorage.getItem('h2o_current')) || 0;
        try {
            historyStack = JSON.parse(localStorage.getItem('h2o_history')) || [];
        } catch(e) { historyStack = []; }
    }

    dailyGoalInput.value = dailyGoal;
    updateUI(false, currentWater);
}

function saveState() {
    localStorage.setItem('h2o_current', currentWater.toString());
    localStorage.setItem('h2o_goal', dailyGoal.toString());
    localStorage.setItem('h2o_streak', streak.toString());
    localStorage.setItem('h2o_completed_days', JSON.stringify(completedDays));
    localStorage.setItem('h2o_history', JSON.stringify(historyStack));
    localStorage.setItem('h2o_date', getTodayStr());
}

function playBubbleSound() {
    try {
        const AudioContext = window.AudioContext || window.webkitAudioContext;
        if (!AudioContext) return;
        const audioCtx = new AudioContext();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        
        osc.type = 'sine';
        osc.frequency.setValueAtTime(190 + Math.random() * 40, audioCtx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(450 + Math.random() * 60, audioCtx.currentTime + 0.18);
        
        gain.gain.setValueAtTime(0.2, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.01, audioCtx.currentTime + 0.18);
        
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + 0.2);
    } catch (e) {}
}

function updateUI(shouldPlaySound = true, oldWaterValue = 0) {
    if (shouldPlaySound) playBubbleSound();

    const percentage = Math.min(Math.round((currentWater / dailyGoal) * 100), 100);
    
    animateCounter('waterAmount', parseInt(waterAmountEl.innerText) || 0, currentWater);
    percentAmountEl.innerText = `${percentage}% выпито`;
    headerGoalEl.innerText = `${dailyGoal}`;
    streakCountEl.innerText = `${streak}`;
    modalStreakCountEl.innerText = `${streak}`;

    undoBtn.disabled = historyStack.length === 0;

    const bottomY = 462;
    const topY = 85;
    const fillFactor = Math.min(currentWater / dailyGoal, 1.0);
    const targetY = bottomY - (fillFactor * (bottomY - topY));
    
    waterFill.setAttribute('y', targetY.toString());
    waterSurface.setAttribute('cy', targetY.toString());
    
    const targetRx = 65 + (fillFactor * (105 - 65));
    waterSurface.setAttribute('rx', targetRx.toString());
    const targetRy = 8 + (fillFactor * (12 - 8));
    waterSurface.setAttribute('ry', targetRy.toString());

    const todayStr = getTodayStr();
    
    // Проверка достижения цели и запуск анимации
    if (currentWater >= dailyGoal && oldWaterValue < dailyGoal && !completedDays.includes(todayStr)) {
        completedDays.push(todayStr);
        streak += 1;
        streakCountEl.innerText = streak;
        saveState();
        
        // Анимация падающей капли
        successDrop.classList.remove('animate');
        void successDrop.offsetWidth; // trigger reflow
        successDrop.classList.add('animate');

        setTimeout(() => {
            openStreakModal();
            if (!confettiActive) triggerConfetti();
        }, 800);
    }
}

function animateCounter(elementId, start, end) {
    const obj = document.getElementById(elementId);
    const range = end - start;
    if (range === 0) return;
    const duration = 500;
    let startTime = null;

    function step(timestamp) {
        if (!startTime) startTime = timestamp;
        const progress = Math.min((timestamp - startTime) / duration, 1);
        obj.innerText = Math.floor(start + (progress * (2 - progress)) * range);
        if (progress < 1) window.requestAnimationFrame(step);
        else obj.innerText = end;
    }
    window.requestAnimationFrame(step);
}

function addWater(amount) {
    const oldWater = currentWater;
    currentWater += amount;
    historyStack.push(amount);
    saveState();
    updateUI(true, oldWater);
}

function addCustomWater() {
    const input = prompt("Введите количество воды (мл):", "300");
    if (input !== null) {
        // Очищаем ввод: оставляем только цифры, решаем проблему с багом
        const cleanInput = input.replace(/\D/g, '');
        const val = parseInt(cleanInput, 10);
        
        if (!isNaN(val) && val > 0 && val <= 5000) {
            addWater(val);
        } else {
            alert("Пожалуйста, введите корректное число (например: 250)");
        }
    }
}

function undoLastAction() {
    if (historyStack.length === 0) return;
    const lastAmount = historyStack.pop();
    const oldWater = currentWater;
    currentWater = Math.max(0, currentWater - lastAmount);
    
    // Если отменили и упали ниже цели, убираем сегодняшний день из стрика
    const todayStr = getTodayStr();
    if (oldWater >= dailyGoal && currentWater < dailyGoal && completedDays.includes(todayStr)) {
        completedDays = completedDays.filter(d => d !== todayStr);
        streak = Math.max(0, streak - 1);
    }
    
    saveState();
    updateUI(false, currentWater);
}

function resetApp() {
    if (confirm("Обнулить весь прогресс за сегодня?")) {
        currentWater = 0;
        historyStack = [];
        
        const todayStr = getTodayStr();
        if (completedDays.includes(todayStr)) {
            completedDays = completedDays.filter(d => d !== todayStr);
            streak = Math.max(0, streak - 1);
        }
        
        saveState();
        updateUI(false, currentWater);
    }
}

